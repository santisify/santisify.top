---
import { Image } from 'astro:assets'

import { Button, Collapse } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import KeyIcon from '@/assets/icons/key.svg'
import wechat from '@/assets/wechat-qrcode.jpg'
import config from '@/site-config'
import {MyIcon} from '@/components/Icons/icons'

const headings = [
  // { depth: 2, slug: 'applications', text: 'Applications' },
  // { depth: 2, slug: 'programs', text: 'Programs' },
  // { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'template', text: 'Template' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }

      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/santisify'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    If you think it would be useful or interesting to collaborate on a project, you can donate to
    support my work or contact me to discuss a project.
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <MyIcon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='others'>Others</h2>
  <ProjectSection
    project={[
      {
        name: 'astro-theme-sify',
        description: '基于 Astro 6 + Tailwind CSS v4 的现代化博客主题。',
        links: [
          { type: 'github', href: 'https://github.com/santisify/astro-theme-sify' },
          { type: 'site', href: 'https://astro-sify-demo.lazy-boy-acmer.cn/' }
        ]
      },
      {
        name: 'sify-gist',
        description: '基于 Supabase + Nextjs 搭建的轻量代码片段分享平台，可部署到Vercel',
        links: [
          { type: 'github', href: 'https://github.com/santisify/astro-theme-sify' },
          { type: 'site', href: 'https://gist.santisify.top' }
        ]
      }
    ]}
  />

  <h2 id='template'>Template</h2>
  <ProjectSection
    project={[
      {
        name: 'nodejs-backend-template',
        description: '基于express的后端模板',
        links: [
          { type: 'github', href: 'https://github.com/santisify/nodejs-backend-template' },
          { type: 'gitee', href: 'https://gitee.com/santisify/nodejs-backend-template' }
        ]
      }
    ]}
  />

  <!--<Collapse title="Some old projects">-->
  <!--  <ProjectSection-->
  <!--    project={[]}-->
  <!--  />-->
  <!--</Collapse>-->

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>Please leave a message or contact me proactively after sponsorship.</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <p>Thanks to the following sponsors:</p>
  <Sponsors
    progressMax={50}
    sponsors={[
      { name: 'lazyboy', platform: 'Wechat', amount: 5, date: '2026-01-09' }
    ]}
  />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
