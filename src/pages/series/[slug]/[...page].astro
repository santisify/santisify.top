---
import { getCollection, render, type CollectionEntry } from 'astro:content'

import { sortMDByDate } from 'astro-pure/server'
import SeriesPost from '@/layouts/SeriesPost.astro'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getCollection('series'))
  return posts.map((post) => ({
    params: { slug: post.id.split('/')[0], page: post.id.split('/').slice(1).join('/') },
    props: { post, posts }
  }))
}

type Props = {
  post: CollectionEntry<'series'>
  posts: CollectionEntry<'series'>[]
}

const { post, posts } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<SeriesPost {post} {posts} {headings} {remarkPluginFrontmatter}>
  <Content />
</SeriesPost>
