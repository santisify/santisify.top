---
import { Image } from 'astro:assets'

import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import Umami from '@/components/about/Umami.astro'
import notByAIImage from '@/assets/not-by-ai-badge.svg'

const headings = [
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'gossips', text: 'Gossips' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p>个人开发者 / 后端开发(个人倾向)</p>
  <p>
    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;我是一名将于2026年毕业的计算机科学与技术专业本科生，拥有三年算法竞赛训练经验，曾多次在睿抗机器人开发者大赛、百度之星、四川省大学生程序设计竞赛、ICPC邀请赛及蓝桥杯等赛事中斩获国家级与省级奖项。具备扎实的数据结构与算法功底，能够高效解决复杂编程问题，同时掌握完整的前后端分离项目独立开发能力——从需求分析、系统架构设计、数据库建模到编码实现与测试部署。此外，我熟悉运用AI辅助开发工具，注重代码规范与交付质量，兼具业务理解力与团队协作精神，善于将实际需求转化为可靠的技术方案。持续学习、乐于分享，希望能在技术的世界里不断创造有价值的作品。
  </p>
  <p>
    座右铭: to simplify technology to its purest, most powerful form.
    <Spoiler>将技术简化为其最纯粹、最强大的形式。</Spoiler>
  </p>
  <Button title='Sponsor Me' class='w-fit' href='/projects#sponsorship' style='ahead' />

